generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Provider {
  EMAIL
  GOOGLE
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  FREE
  CREATED
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  HALTED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String?
  avatar   String?
  provider Provider @default(EMAIL)
  role     Role     @default(USER)

  emailVerified Boolean @default(false)

  // Storage
  storageUsed  BigInt @default(0)
  storageLimit BigInt @default(1073741824)

  // Subscription
  plan               Plan               @default(FREE)
  subscriptionStatus SubscriptionStatus @default(FREE)
  currentPeriodEnd   DateTime?
  gracePeriodEnd     DateTime?

  // Relationships
  files         File[]
  sessions      Session[]
  subscriptions Subscription[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id    String @id @default(uuid())
  name  String
  type  String
  size  BigInt
  s3Key String @unique
  url   String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String @id @default(uuid())
  tokenHash String @unique
  userId    String
  deviceId  String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([expiresAt])
}

model EmailVerificationOTP {
  id                         String    @id @default(uuid())
  email                      String
  codeHash                   String
  expiresAt                  DateTime
  attempts                   Int       @default(0)
  verifiedAt                 DateTime?
  registrationGrantExpiresAt DateTime?
  createdAt                  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  plan Plan

  // Razorpay references
  razorpayPlanId         String
  razorpaySubscriptionId String @unique
  checkoutUrl            String?

  status SubscriptionStatus @default(CREATED)

  // Billing period
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Subscription lifecycle
  startDate         DateTime?
  endDate           DateTime?
  cancelledAt       DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  // Payment recovery
  gracePeriodEnd DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model Payment {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  // Razorpay references
  razorpayPaymentId String? @unique

  // Amount stored in paise (₹149 = 14900)
  amount         Int
  amountRefunded Int          @default(0)
  currency       String       @default("INR")
  status         PaymentStatus

  paidAt        DateTime?
  failureReason String?

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([status])
}

model Refund {
  id String @id @default(uuid())

  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  razorpayRefundId String   @unique
  amount           Int
  currency         String   @default("INR")
  processedAt      DateTime

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
}

model RazorpayWebhookEvent {
  id String @id @default(uuid())

  // Razorpay event identification
  eventId   String @unique
  eventType String

  razorpaySubscriptionId String?

  // Original webhook payload
  payload Json

  // Processing status
  status WebhookStatus @default(PENDING)

  responseMessage String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType])
  @@index([status])
  @@index([receivedAt])
  @@index([razorpaySubscriptionId])
}
