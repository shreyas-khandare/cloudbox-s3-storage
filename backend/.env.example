
# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=

# Frontend
CLIENT_URL=http://localhost:5173

# Google OAuth / OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email service (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Razorpay Subscriptions
# Use credentials and plan IDs from the same Razorpay mode (Test or Live).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_BUSINESS_PLAN_ID=
# Required for processing subscription events and activating paid entitlements.
RAZORPAY_WEBHOOK_SECRET=
